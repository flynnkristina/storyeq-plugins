{
  "name": "storyeq-hosted-library",
  "version": "0.4.0",
  "private": true,
  "description": "The library connector as a hosted Cloudflare Worker, behind Cloudflare Access. One deploy, three addresses: /team (read-only), /leader (the leader's writer), /evalbot (the eval bot).",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "node --test test/",
    "type-check": "tsc --noEmit",
    "test:live": "esbuild test/live-drive.ts --bundle --platform=node --format=esm --alias:google-auth-library=./src/no-google-auth.js --outfile=.wrangler/live-drive.mjs --log-level=warning && node .wrangler/live-drive.mjs",
    "test:unit": "esbuild test/team-notes.unit.ts --bundle --platform=node --format=esm --alias:google-auth-library=./src/no-google-auth.js --outfile=.wrangler/team-notes.unit.mjs --log-level=warning && node .wrangler/team-notes.unit.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "esbuild": "^0.25.12",
    "typescript": "6.0.3",
    "wrangler": "^4.105.0"
  }
}
